---
import LastUpdated from '@astrojs/starlight/components/LastUpdated.astro';
import Pagination from '@astrojs/starlight/components/Pagination.astro';
---

<footer class="sl-flex">
	<div class="meta sl-flex">
		<LastUpdated />
	</div>

	<div class="feedback-section">
		<span class="feedback-label">Was this page helpful?</span>
		<div class="feedback-buttons">
			<button type="button" class="thumb-btn" aria-label="Yes, this was helpful" data-feedback="yes">
				<svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 24 24" width="16" height="16" xmlns="http://www.w3.org/2000/svg">
					<path fill="none" d="M0 0h24v24H0V0zm0 0h24v24H0V0z"></path>
					<path d="M9 21h9c.83 0 1.54-.5 1.84-1.22l3.02-7.05c.09-.23.14-.47.14-.73v-2c0-1.1-.9-2-2-2h-6.31l.95-4.57.03-.32c0-.41-.17-.79-.44-1.06L14.17 1 7.58 7.59C7.22 7.95 7 8.45 7 9v10c0 1.1.9 2 2 2zM9 9l4.34-4.34L12 10h9v2l-3 7H9V9zM1 9h4v12H1z"></path>
				</svg>
				<span>Yes</span>
			</button>
			<button type="button" class="thumb-btn" aria-label="No, this was not helpful" data-feedback="no">
				<svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 24 24" width="16" height="16" xmlns="http://www.w3.org/2000/svg">
					<path fill="none" d="M0 0h24v24H0V0zm0 0h24v24H0V0z"></path>
					<path d="M15 3H6c-.83 0-1.54.5-1.84 1.22l-3.02 7.05c-.09.23-.14.47-.14.73v2c0 1.1.9 2 2 2h6.31l-.95 4.57-.03.32c0 .41.17.79.44 1.06L9.83 23l6.59-6.59c.36-.36.58-.86.58-1.41V5c0-1.1-.9-2-2-2zm0 12-4.34 4.34L12 14H3v-2l3-7h9v10zm4-12h4v12h-4z"></path>
				</svg>
				<span>No</span>
			</button>
		</div>
	</div>

	<Pagination />

	<div class="copyright">
		&copy; {new Date().getFullYear()} OpenPlanetData &mdash; Made with &#10084; by <a href="https://github.com/laurentpellegrino" target="_blank" rel="noopener">Laurent Pellegrino</a> and <a href="https://github.com/openplanetdata" target="_blank" rel="noopener">contributors</a>.
	</div>
</footer>

<script>
	import { initPageFeedback } from './page-feedback.ts';

	initPageFeedback();

	// Make sidebar group labels clickable to their overview pages
	const groupLinks: Record<string, string> = {
		'Datasets': '/datasets/',
		'Boundaries': '/datasets/boundaries/',
	};

	document.querySelectorAll('.sidebar-content summary .group-label .large').forEach(label => {
		const text = label.textContent?.trim() || '';
		const href = groupLinks[text];
		if (!href) return;
		const groupLabel = label.closest('.group-label');
		if (!groupLabel || groupLabel.hasAttribute('data-linked')) return;
		groupLabel.setAttribute('data-linked', 'true');
		(groupLabel as HTMLElement).style.cursor = 'pointer';
		groupLabel.addEventListener('click', (e) => {
			e.preventDefault();
			e.stopPropagation();
			window.location.href = href;
		});
		// Apply active state when on the linked page
		if (window.location.pathname === href) {
			const summary = groupLabel.closest('summary');
			if (summary) {
				summary.setAttribute('aria-current', 'page');
			}
		}
	});
</script>

<style>
	footer {
		flex-direction: column;
		gap: 1.5rem;
	}

	.meta {
		gap: 0.75rem 3rem;
		justify-content: space-between;
		flex-wrap: wrap;
		margin-top: 3rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}

	.meta > :global(p:only-child) {
		margin-inline-start: auto;
	}

	.feedback-section {
		display: flex;
		align-items: center;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.feedback-label {
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
	}

	.feedback-buttons {
		display: flex;
		gap: 0.5rem;
	}

	.thumb-btn {
		display: flex;
		align-items: center;
		gap: 0.375rem;
		padding: 0.375rem 0.75rem;
		background: var(--glass-bg, rgba(255,255,255,0.45));
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border: 1px solid var(--glass-border, rgba(255,255,255,0.5));
		border-radius: 50px;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
		cursor: pointer;
		transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
		box-shadow: 0 2px 8px rgba(0,0,0,0.04);
	}

	.thumb-btn:hover {
		color: var(--sl-color-accent);
		border-color: var(--sl-color-accent);
		box-shadow: 0 4px 12px rgba(45,106,79,0.1);
	}

	.thumb-btn.active {
		color: var(--sl-color-accent);
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent-low);
		box-shadow: 0 4px 12px rgba(45,106,79,0.15);
	}

	.feedback-thanks {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-accent);
	}

	.copyright {
		text-align: center;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
		padding-top: 1rem;
	}

	.copyright a {
		color: var(--sl-color-gray-2);
		text-decoration: none;
	}

	.copyright a:hover {
		color: var(--sl-color-accent);
	}
</style>

<style is:global>
	/* The dialogs are appended to <body>, so they sit outside scoped styles. */

	.feedback-dialog {
		/* Tells the browser which palette to draw native controls with. Without
		   it the <select> popup renders light while inheriting light text. */
		color-scheme: light;
		/* Overriding width defeats the UA stylesheet's `width: fit-content` +
		   `margin: auto` centring, so both axes are re-centred explicitly. */
		position: fixed;
		inset: 0;
		margin: auto;
		padding: 0;
		border: 1px solid var(--glass-border);
		border-radius: 20px;
		background: var(--sl-color-bg);
		color: var(--sl-color-text);
		box-shadow: 0 24px 80px rgba(0, 0, 0, 0.28);
		max-width: 34rem;
		width: calc(100% - 2rem);
		max-height: 85vh;
		overflow-y: auto;
	}

	:root[data-theme='dark'] .feedback-dialog {
		color-scheme: dark;
		background: #1a2620;
		border-color: rgba(255, 255, 255, 0.12);
	}

	.feedback-dialog::backdrop {
		background: rgba(0, 0, 0, 0.45);
		backdrop-filter: blur(4px);
		-webkit-backdrop-filter: blur(4px);
	}

	.feedback-dialog > *,
	.feedback-dialog .feedback-form {
		padding: 0;
	}

	.feedback-dialog-share,
	.feedback-dialog .feedback-form {
		padding: 2rem;
	}

	.feedback-dialog-title {
		margin: 0 0 0.75rem;
		font-family: 'DM Serif Display', Georgia, serif;
		font-weight: 400;
		font-size: 1.5rem;
		line-height: 1.2;
		color: var(--sl-color-white);
	}

	.feedback-dialog-text {
		margin: 0 0 1.5rem;
		font-size: var(--sl-text-sm);
		line-height: 1.65;
		color: var(--sl-color-gray-2);
	}

	/* ----- Share ----- */

	.feedback-share-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr));
		gap: 0.5rem;
	}

	.feedback-share-link {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		padding: 0.7rem 0.9rem;
		border: 1px solid var(--glass-border);
		border-radius: 12px;
		background: var(--glass-bg);
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
		font-family: inherit;
		text-decoration: none;
		cursor: pointer;
		transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.feedback-share-link:hover {
		background: var(--glass-bg-hover);
		border-color: var(--sl-color-accent);
		color: var(--sl-color-accent);
		transform: translateY(-1px);
	}

	.feedback-share-link svg {
		flex: none;
	}

	/* ----- Comment form ----- */

	.feedback-field {
		display: block;
		margin-bottom: 1.15rem;
	}

	.feedback-field-label {
		display: block;
		margin-bottom: 0.4rem;
		font-size: var(--sl-text-sm);
		font-weight: 500;
		color: var(--sl-color-white);
	}

	.feedback-optional {
		font-weight: 400;
		color: var(--sl-color-gray-3);
	}

	.feedback-select,
	.feedback-input,
	.feedback-textarea {
		width: 100%;
		padding: 0.6rem 0.75rem;
		border: 1px solid var(--glass-border);
		border-radius: 10px;
		background: var(--glass-bg);
		color: var(--sl-color-text);
		font-family: inherit;
		font-size: var(--sl-text-sm);
		transition: border-color 0.2s ease;
	}

	/* The popup list is drawn by the OS and cannot use a translucent glass
	   background, so the select carries a solid one and the options are given
	   explicit colours rather than inheriting the page's. */
	.feedback-select {
		background: var(--sl-color-bg);
		color: var(--sl-color-text);
		appearance: none;
		background-image: linear-gradient(45deg, transparent 50%, currentColor 50%),
			linear-gradient(135deg, currentColor 50%, transparent 50%);
		background-position: calc(100% - 1.1rem) 55%, calc(100% - 0.75rem) 55%;
		background-size: 0.35rem 0.35rem, 0.35rem 0.35rem;
		background-repeat: no-repeat;
		padding-right: 2.25rem;
	}

	.feedback-select option {
		background: var(--sl-color-bg);
		color: var(--sl-color-text);
	}

	:root[data-theme='dark'] .feedback-select,
	:root[data-theme='dark'] .feedback-select option {
		background-color: #1a2620;
		color: var(--sl-color-text);
	}

	.feedback-textarea {
		resize: vertical;
		min-height: 6rem;
		line-height: 1.5;
	}

	.feedback-select:focus,
	.feedback-input:focus,
	.feedback-textarea:focus {
		outline: none;
		border-color: var(--sl-color-accent);
	}

	.feedback-counter {
		display: block;
		margin-top: 0.3rem;
		text-align: right;
		font-size: 0.75rem;
		color: var(--sl-color-gray-3);
		font-variant-numeric: tabular-nums;
	}

	/* Off-screen rather than display:none — some bots skip hidden inputs. */
	.feedback-honeypot {
		position: absolute;
		left: -9999px;
		width: 1px;
		height: 1px;
		overflow: hidden;
	}

	.feedback-status:empty {
		display: none;
	}

	.feedback-status {
		margin: 0 0 1rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}

	.feedback-status[data-tone='error'] {
		color: #d03b3b;
	}

	:root[data-theme='dark'] .feedback-status[data-tone='error'] {
		color: #e88a8a;
	}

	.feedback-dialog-actions {
		display: flex;
		justify-content: flex-end;
		gap: 0.6rem;
		margin-top: 1.5rem;
	}

	.feedback-btn {
		padding: 0.55rem 1.1rem;
		border-radius: 50px;
		border: 1px solid transparent;
		font-family: inherit;
		font-size: var(--sl-text-sm);
		font-weight: 500;
		cursor: pointer;
		transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.feedback-btn-ghost {
		background: transparent;
		border-color: var(--glass-border);
		color: var(--sl-color-gray-3);
	}

	.feedback-btn-ghost:hover {
		color: var(--sl-color-text);
		border-color: var(--sl-color-gray-4);
	}

	.feedback-btn-primary {
		background: var(--sl-color-accent);
		color: #fff;
	}

	:root[data-theme='dark'] .feedback-btn-primary {
		color: #0e1a14;
	}

	.feedback-btn-primary:hover:not(:disabled) {
		background: var(--sl-color-accent-high);
	}

	.feedback-btn-primary:disabled {
		opacity: 0.6;
		cursor: default;
	}
</style>
